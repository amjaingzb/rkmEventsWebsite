# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Environment mode (compile-time; NOT a runtime feature flag) ---
# "development" (default if unset/unrecognized) or "live". Controls:
#   - CONTACT_EMAIL (src/lib/contact.ts): dev placeholder vs real org address
#   - PhonePe credentials (src/lib/payment/phonepe.ts): forces sandbox
#     defaults in development; in live mode falls back to sandbox too until
#     real PHONEPE_* creds below are set (src/lib/environmentBanner.ts
#     surfaces that state with a visible banner instead of failing silently).
# Unrelated to events.payment_mode (a runtime, per-event, admin-toggleable
# DB flag selecting manual vs PhonePe payment) — that is orthogonal.
# Must be NEXT_PUBLIC_-prefixed (baked in at build time) so it's visible to
# both client and server code. Set once per deploy target, don't flip at
# runtime. See docs/architecture.md "Environment mode" and docs/netlify.md.
NEXT_PUBLIC_APP_MODE=development

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign/verify the QR ticket payload (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
TICKET_HMAC_SECRET=change-me

# Slug of the events row this deployment serves.
EVENT_SLUG=halasuru-sarvapriyananda-2026

# Email sending (Resend). Get a free API key at https://resend.com
RESEND_API_KEY=your-resend-api-key
TICKET_FROM_EMAIL=tickets@yourdomain.com

# --- Phase B / PhonePe sandbox demo only (not required for Phase A) ---
# These are PhonePe's PUBLICLY PUBLISHED sandbox test credentials, shared by
# every integrator testing against their preprod environment — safe to
# commit/share, not specific to this org, and not usable for real payments.
# The code (src/lib/payment/phonepe.ts) falls back to these same values if
# left blank, so this section is optional to fill in for local dev. Only
# honored at all when NEXT_PUBLIC_APP_MODE=live — in development mode these
# are ignored entirely and the sandbox defaults are always used instead.
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
