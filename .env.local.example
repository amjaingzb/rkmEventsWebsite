# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Environment mode (compile-time; NOT a runtime feature flag) ---
# "development" (default if unset/unrecognized) or "live". Controls:
#   - CONTACT_EMAIL (src/lib/contact.ts): dev placeholder vs real org address
#   - PhonePe credentials (src/lib/payment/phonepe.ts): forces the sandbox
#     environment in development regardless of PHONEPE_ENV; in live mode
#     stays on sandbox until PHONEPE_ENV=production is set
#     (src/lib/environmentBanner.ts surfaces that state with a visible
#     banner instead of failing silently).
# Unrelated to events.payment_mode (a runtime, per-event, admin-toggleable
# DB flag selecting manual vs PhonePe payment) — that is orthogonal.
# Must be NEXT_PUBLIC_-prefixed (baked in at build time) so it's visible to
# both client and server code. Set once per deploy target, don't flip at
# runtime. See docs/architecture.md "Environment mode" and docs/netlify.md.
NEXT_PUBLIC_APP_MODE=development

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign/verify the QR ticket payload (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
TICKET_HMAC_SECRET=change-me

# Slug of the events row this deployment serves.
EVENT_SLUG=halasuru-sarvapriyananda-2026

# Email sending (Resend). Get a free API key at https://resend.com
RESEND_API_KEY=your-resend-api-key
TICKET_FROM_EMAIL=tickets@yourdomain.com

# --- Phase B / PhonePe sandbox demo only (not required for Phase A) ---
# PhonePe's V2 "Standard Checkout" API — rewritten 2026-09 after PhonePe
# deprecated V1 entirely (see docs/BACKLOG.md item 6). Unlike V1, there is
# NO publicly shared sandbox credential for V2 — every integrator, even in
# Test Mode, must sign up at business.phonepe.com and copy their own
# Client ID/Secret from Developer Settings. Nothing below has a working
# default; leave unset until that signup happens.
#
# Sandbox and production creds are separate env vars on purpose: in
# development mode (NEXT_PUBLIC_APP_MODE=development) only the
# PHONEPE_SANDBOX_* vars are ever read, regardless of PHONEPE_ENV — so a
# shared secrets file can't leak production credentials into a local run.
PHONEPE_ENV=sandbox
PHONEPE_SANDBOX_CLIENT_ID=
PHONEPE_SANDBOX_CLIENT_SECRET=
PHONEPE_SANDBOX_CLIENT_VERSION=1
PHONEPE_PRODUCTION_CLIENT_ID=
PHONEPE_PRODUCTION_CLIENT_SECRET=
PHONEPE_PRODUCTION_CLIENT_VERSION=1

# Webhook auth (SHA/username-password method) — configure a webhook with
# this same username/password in the PhonePe Business Dashboard's
# Developer Settings → Webhook screen; the webhook URL itself is set there
# too (V2 doesn't accept a callback URL per-request like V1 did).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
